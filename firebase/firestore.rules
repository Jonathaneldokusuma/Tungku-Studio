rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn() && userProfile().data.role == role;
    }

    function internalUser() {
      return hasRole('manager') || hasRole('operator');
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || internalUser());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || hasRole('manager'));
      allow delete: if hasRole('manager');
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if hasRole('manager');
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || internalUser());
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update: if signedIn() && (resource.data.clientId == request.auth.uid || internalUser());
      allow delete: if hasRole('manager');
    }

    match /custom_offers/{offerId} {
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || internalUser());
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.clientId == request.auth.uid || hasRole('manager'));
    }

    match /quotations/{quotationId} {
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || internalUser());
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update: if signedIn() && (resource.data.clientId == request.auth.uid || hasRole('manager'));
      allow delete: if hasRole('manager');
    }

    match /quotation_offers/{offerId} {
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || internalUser());
      allow create, update, delete: if hasRole('manager');
    }

    match /projects/{projectId} {
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || internalUser());
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if internalUser();
    }

    match /recording_sessions/{sessionId} {
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || internalUser());
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if internalUser();
    }

    match /project_stages/{stageId} {
      allow read: if signedIn() && internalUser();
      allow write: if hasRole('manager');
    }

    match /track_stage_progress/{progressId} {
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || resource.data.operatorId == request.auth.uid || internalUser());
      allow create, update: if internalUser();
      allow delete: if hasRole('manager');
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || hasRole('manager'));
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if hasRole('manager');
    }

    match /expenses/{expenseId} {
      allow read, write: if hasRole('manager');
    }

    match /inventories/{inventoryId} {
      allow read, write: if internalUser();
    }

    match /crm_clients/{clientId} {
      allow read, write: if hasRole('manager');
    }

    match /tasks/{taskId} {
      allow read: if signedIn() && (resource.data.operatorId == request.auth.uid || hasRole('manager'));
      allow write: if internalUser();
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        resource.data.audience == 'client' ||
        (resource.data.audience == 'manager' && hasRole('manager')) ||
        (resource.data.audience == 'operator' && hasRole('operator')) ||
        internalUser()
      );
      allow create: if signedIn() && (
        internalUser() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.audience in ['manager', 'operator']
      );
      allow delete: if internalUser();
    }

    match /crm_messages/{messageId} {
      allow read: if signedIn() && (resource.data.clientId == request.auth.uid || hasRole('manager'));
      allow write: if hasRole('manager');
    }

    match /finance_reports/{reportId} {
      allow read, write: if hasRole('manager');
    }
  }
}
